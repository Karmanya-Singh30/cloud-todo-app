# Copy these into your shell or hosting dashboard. The app reads them from the
# environment; it does not load a .env file by itself.

# Required in production: long random string used to sign session cookies.
SECRET_KEY=replace-with-a-long-random-value

# Optional: where the SQLite file lives (default: tasks.db next to app.py).
DATABASE_PATH=tasks.db

# Optional: port for `python app.py` (Render/gunicorn set this automatically).
PORT=5000

# Optional, local only: 1 enables the Flask debugger (binds to 127.0.0.1).
FLASK_DEBUG=0
